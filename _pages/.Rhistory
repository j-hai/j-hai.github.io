f2_t <- cos(seq(0, 2*pi, length.out = Tt))
lambda1_i <- rnorm(N, 0, 1)
lambda2_i <- rnorm(N, 0, 1)
# Staggered adoption times (never-treated units exist)
g <- sample(c(8:15, Inf), N, replace = TRUE)
g
## ===========================================================
## 0. Setup
## ===========================================================
set.seed(123)
library(dplyr)
library(fect)
## ===========================================================
## 1. Simulate panel data: common treatment time, continuous dose
## ===========================================================
N  <- 200   # number of units
Tt <- 20    # number of time periods
T0 <- 11    # first treated period for everyone  (event_time = 0)
id <- rep(1:N, each = Tt)
t  <- rep(1:Tt, N)
# Unit and time fixed effects
alpha_i <- rnorm(N, 0, 1)       # unit FE
gamma_t <- rnorm(Tt, 0, 1)      # time FE
# True IFE structure: 2 factors
f1_t <- sin(seq(0, 2*pi, length.out = Tt))
f2_t <- cos(seq(0, 2*pi, length.out = Tt))
lambda1_i <- rnorm(N, 0, 1)
lambda2_i <- rnorm(N, 0, 1)
# Assemble baseline panel
df <- data.frame(id = id, t = t)
# Common treatment timing: untreated before T0, treated after
df <- df %>%
mutate(
treated        = ifelse(t >= T0, 1, 0),
# continuous treatment intensity grows linearly after T0
treat_intensity = ifelse(t >= T0, t - T0 + 1, 0),
event_time      = t - T0     # event_time = 0 is first treated period
)
# True event-time pattern (for illustration)
true_beta <- function(et) {
if (et < 0) return(0)          # no anticipation
if (et == 0) return(0.5)
if (et == 1) return(1.0)
if (et == 2) return(1.5)
if (et >= 3) return(2.0)
}
df$true_effect <- sapply(df$event_time, true_beta) * df$treat_intensity
# Outcome: FE + IFE + treatment + noise
df$y <-
alpha_i[df$id] +
gamma_t[df$t] +
lambda1_i[df$id] * f1_t[df$t] +
lambda2_i[df$id] * f2_t[df$t] +
df$true_effect +
rnorm(nrow(df), 0, 1)
df
dim(df)
## ===========================================================
## 2. Build event-time interactions for event-study IFE
## ===========================================================
event_window <- -5:5          # only estimate in a +/- 5 window
ref_event    <- -1            # reference category
df_es <- df %>%
mutate(
event_time_trim = ifelse(event_time >= min(event_window) &
event_time <= max(event_window),
event_time, NA)
)
# Create treat_intensity * 1{event_time = k} for each k != ref_event
for (k in event_window[event_window != ref_event]) {
vname <- if (k < 0) paste0("D_m", abs(k)) else paste0("D_p", k)
df_es[[vname]] <- ifelse(event_time_trim == k, treat_intensity, 0)
}
library(dplyr)
library(fect)
set.seed(123)
## ===========================================================
## 1. (Optional) Simulate a panel with time-invariant treatment
## ===========================================================
N  <- 200   # units
Tt <- 15    # years, e.g. 2005–2019
years <- 2005 + 0:(Tt - 1)
id <- rep(1:N, each = Tt)
year <- rep(years, times = N)
# time-invariant continuous treatment for each unit (e.g., intensity)
treat_i <- runif(N, 0, 2)     # continuous scalar per unit
treat   <- rep(treat_i, each = Tt)
# some IFE-ish structure + treatment effect that grows over time
alpha_i <- rnorm(N)                     # unit FE
gamma_t <- rnorm(Tt)                    # time FE
f_t     <- sin(seq(0, 2*pi, length.out = Tt))
lambda_i <- rnorm(N)
df <- data.frame(id = id, year = year, treat = treat)
df <- df %>%
mutate(
# true effect of treatment varies by year (you can change this)
true_beta_year = (year - min(year)) / 10,     # increasing over time
y = alpha_i[id] +
gamma_t[match(year, years)] +
lambda_i[id] * f_t[match(year, years)] +
true_beta_year * treat +                 # treatment effect
rnorm(n(), 0, 1)
)
df
## ===========================================================
## 2. Build treat × time-dummy regressors (event-style)
##    One β per year relative to a reference year
## ===========================================================
ref_year <- 2010          # reference category
# All years we want coefficients for:
all_years <- sort(unique(df$year))
# Create interaction variables: treat * 1{year == t} for each t != ref_year
for (yy in all_years[all_years != ref_year]) {
vname <- paste0("TR_", yy)
df[[vname]] <- ifelse(df$year == yy, df$treat, 0)
}
df
# List of regressors in time order
x_vars <- paste0("TR_", all_years[all_years != ref_year])
## ===========================================================
## 3. Fit IFE model with interFE()
## ===========================================================
form_ife <- as.formula(
paste("y ~", paste(x_vars, collapse = " + "))
)
form_ife
ife_fit <- interFE(
formula = form_ife,
data    = df,
index   = c("id", "year"),
r       = 2,          # number of interactive factors (choose via IC in practice)
force   = "two-way",  # unit + time FE + IFE factors
se      = TRUE,
nboots  = 100
)
summary(ife_fit)
beta_hat <- coef(ife_fit)[x_vars]
es_df <- data.frame(
year = all_years[all_years != ref_year],
beta = as.numeric(beta_hat)
)
beta_hat
coef(ife_fit)
names(ife_fit)
coef(ife_fit)
ife_fit$beta
?interFE
ife_fit$est.table
ife_fit$est.table[x_vars]
ife_fit$est.table[x_vars,]
beta_hat <- ife_fit$est.table[x_vars,Coef]
beta_hat <- ife_fit$est.table[x_vars,"Coef"]
es_df <- data.frame(
year = all_years[all_years != ref_year],
beta = as.numeric(beta_hat)
)
print(es_df)
# Simple plot
plot(es_df$year, es_df$beta, type = "b", pch = 16,
xlab = "Year",
ylab = "Effect of treatment (relative to reference year)",
main = paste("Treatment × Year IFE (ref =", ref_year, ")"))
abline(h = 0, lty = 2)
library(dplyr)
library(fect)
set.seed(123)
## ===========================================================
## 1. Simulate a panel with time-invariant continuous treatment
##    and NO effect prior to 2010
## ===========================================================
N  <- 200                 # number of units
Tt <- 16                  # number of periods
years <- 2000:(2000 + Tt - 1)  # 2000–2015
id   <- rep(1:N, each = Tt)
year <- rep(years, times = N)
# Time-invariant continuous treatment per unit (e.g., intensity)
treat_i <- runif(N, 0, 2)   # unit-level treatment dose
treat   <- rep(treat_i, each = Tt)
# Unit and time fixed effects
alpha_i <- rnorm(N, 0, 1)    # unit FE
gamma_t <- rnorm(Tt, 0, 1)   # time FE
# One latent factor for IFE structure
f_t      <- sin(seq(0, 2*pi, length.out = Tt))
lambda_i <- rnorm(N, 0, 1)
df <- data.frame(id = id, year = year, treat = treat)
## True treatment effect by year:
## - zero before 2010
## - ramping up after 2010
df <- df %>%
mutate(
true_beta_year = case_when(
year <= 2009 ~ 0,                                  # NO effect pre-2010
year == 2010 ~ 0.5,
year == 2011 ~ 1.0,
year == 2012 ~ 1.5,
year >  2012 ~ 2.0
),
# Outcome: FE + IFE + treatment effect + noise
y = alpha_i[id] +
gamma_t[match(year, years)] +
lambda_i[id] * f_t[match(year, years)] +
true_beta_year * treat +                    # treatment effect
rnorm(n(), 0, 1)
)
## ===========================================================
## 2. Build treat × year-dummy regressors
##    One β per year, relative to a PRE-treatment reference year
## ===========================================================
ref_year <- 2009   # reference year in PRE-period
all_years <- sort(unique(df$year))
# Create interaction vars: treat * 1{year == yy} for each yy != ref_year
for (yy in all_years[all_years != ref_year]) {
vname <- paste0("TR_", yy)
df[[vname]] <- ifelse(df$year == yy, df$treat, 0)
}
# Regressors in chronological order
x_vars <- paste0("TR_", all_years[all_years != ref_year])
## ===========================================================
## 3. Fit IFE model with interFE()
## ===========================================================
form_ife <- as.formula(
paste("y ~", paste(x_vars, collapse = " + "))
)
ife_fit <- interFE(
formula = form_ife,
data    = df,
index   = c("id", "year"),
r       = 1,          # number of interactive factors; increase if needed
force   = "two-way",  # unit + time FE + IFE factors
se      = TRUE,
nboots  = 100
)
summary(ife_fit)
## ===========================================================
## 4. Extract β(year): effect of treatment in each year
##    relative to reference year (2009)
## ===========================================================
beta_hat <- coef(ife_fit)[x_vars]
es_df <- data.frame(
year = all_years[all_years != ref_year],
beta = as.numeric(beta_hat)
)
beta_hat <- ife_fit$est.table[x_vars,"Coef"]
es_df <- data.frame(
year = all_years[all_years != ref_year],
beta = as.numeric(beta_hat)
)
print(es_df)
## Simple event-study style plot
plot(es_df$year, es_df$beta, type = "b", pch = 16,
xlab = "Year",
ylab = "Effect of treatment (relative to 2009)",
main = "Treatment × Year IFE (no effect before 2010)")
abline(h = 0, lty = 2)
# Optional vertical line at 2010 (start of effect)
abline(v = 2010, lty = 3)
