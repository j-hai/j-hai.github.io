## ===========================================================
## 0. Load required packages
## ===========================================================
library(dplyr)
library(fect)
set.seed(123)
## ===========================================================
## 1. Simulate panel data with staggered adoption
## ===========================================================
N  <- 200      # units
Tt <- 20       # time periods
id <- rep(1:N, each = Tt)
t  <- rep(1:Tt, N)
# Unit fixed effects
alpha_i <- rnorm(N, 0, 1)
# Time fixed effects
gamma_t <- rnorm(Tt, 0, 1)
# Two latent factors (true IFE)
f1_t <- sin(seq(0, 2*pi, length.out = Tt))
f2_t <- cos(seq(0, 2*pi, length.out = Tt))
lambda1_i <- rnorm(N, 0, 1)
lambda2_i <- rnorm(N, 0, 1)
# Staggered adoption times (never-treated units exist)
g <- sample(c(8:15, Inf), N, replace = TRUE)
## Continuous treatment intensity after adoption
df <- data.frame(id = id, t = t)
df$g <- rep(g, each = Tt)
df <- df %>%
mutate(
treated = ifelse(t >= g & is.finite(g), 1, 0),
treat_intensity = treated * pmax(0, t - g + 1)  # continuous rising treatment
)
## True treatment effect varies by event time:
true_beta <- function(event_time) {
if (event_time < 0) return(0)         # no anticipation
if (event_time == 0) return(0.5)
if (event_time == 1) return(1.0)
if (event_time == 2) return(1.5)
return(2)                             # plateau
}
df$event_time <- with(df, ifelse(is.finite(g), t - g, NA))
df$true_effect <- sapply(df$event_time, true_beta) * df$treat_intensity
## ===========================================================
## 0. Load required packages
## ===========================================================
library(dplyr)
library(fect)
set.seed(123)
## ===========================================================
## 1. Simulate panel data with staggered adoption
## ===========================================================
N  <- 200      # units
Tt <- 20       # time periods
id <- rep(1:N, each = Tt)
t  <- rep(1:Tt, N)
# Unit fixed effects
alpha_i <- rnorm(N, 0, 1)
# Time fixed effects
